{
  "name": "play-4096-laya",
  "version": "0.1.0",
  "description": "Play 4096 (a 2048 variant) via Playwright, asking a local Laya System-1 model for the best move",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "tsx src/play4096-laya.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@receptron/laya": "^0.1.2",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "esbuild@0.28.2": true
  }
}
